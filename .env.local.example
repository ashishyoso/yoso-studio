# Copy to .env.local and fill in.
# Without a key the app runs in MOCK mode: strategy + slide plan return
# deterministic sample data so you can exercise the full pipeline + rendering.
ANTHROPIC_API_KEY=

# Model used for the strategy + slide-planning engines. Defaults to claude-opus-4-8.
STUDIO_MODEL=claude-opus-4-8

# Nano Banana image generation (Google Gemini). Get a key: https://aistudio.google.com/apikey
# Without it, generated-element slides fall back to branded placeholders.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI image generation (alternative provider, selectable in the UI).
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

